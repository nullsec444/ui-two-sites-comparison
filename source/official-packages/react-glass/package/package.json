{
  "name": "@movements/react-glass",
  "version": "0.1.0",
  "description": "Refractive glass for React \u2014 rim, bend, blur, and chromatic aberration, configured entirely through props.",
  "keywords": [
    "react",
    "glass",
    "glassmorphism",
    "backdrop-filter",
    "refraction"
  ],
  "homepage": "https://movements.dev/glass",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iduuck/movements.dev.git",
    "directory": "packages/react-glass"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
